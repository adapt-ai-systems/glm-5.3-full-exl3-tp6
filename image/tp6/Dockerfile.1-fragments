# Step 1: six-rank expert-fragment runtime on the MiaAI ARM base image (see image/README.md for the build context).
FROM ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3-e3-20260907
COPY b12x /opt/tr3/b12x
COPY quantization /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/
COPY exl3_cached.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/exl3.py
COPY patch_runtime.py /opt/tr3/patch_runtime.py
COPY runtime /opt/glm6
COPY sm120_dcp.py /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/backends/mla/flashinfer_mla_sparse_sm120.py
COPY mla_attn_dcp.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/attention/mla_attention.py
RUN python3 /opt/tr3/patch_runtime.py && python3 /opt/glm6/patch_vllm.py
ENV PYTHONPATH=/opt/glm6:/opt/tr3
